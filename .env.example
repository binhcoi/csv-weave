# Copy to .env and adjust. Read by Docker Compose and by docker run --env-file.

# Owner of files the container writes into the mounted repository. Docker Compose
# builds the image with these; set them to the output of `id -u` and `id -g` if
# those are not 1000. (With docker build, pass --build-arg APP_UID=... APP_GID=...)
LOCAL_UID=1000
LOCAL_GID=1000

RAILS_ENV=development

# Host ports for the Rails API and the Vite frontend dev server.
API_PORT=3000
UI_PORT=5173

# PostgreSQL connection. Compose overrides DB_HOST to its own db service.
DB_HOST=db
DB_USER=postgres
DB_PASSWORD=postgres
# Database name prefix: _development, _development_queue, and _test are appended.
DB_NAME=csv_weave

# Run the background job worker inside the Rails server.
SOLID_QUEUE_IN_PUMA=1

# Keep the server pid inside the container so a recreated container never sees a stale pid file.
PIDFILE=/tmp/server.pid
