#!/usr/bin/env bash
# Start the development server(s) from anywhere in the repository.
#
# Serves the API on API_PORT inside the container. The frontend process joins
# this script once frontend/ exists.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

exec "$ROOT/bin/rails" server -b 0.0.0.0 "$@"
