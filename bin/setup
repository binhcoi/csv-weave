#!/usr/bin/env bash
# Prepare the development environment. Safe to re-run.
#
# In a worktree container, run this once before the first start so the
# container's own database exists and is migrated.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export BUNDLE_GEMFILE="$ROOT/backend/Gemfile"

echo "== installing backend dependencies =="
(
  cd "$ROOT/backend"
  bundle check || bundle install
)

echo "== preparing database =="
"$ROOT/bin/rails" db:prepare

echo "== done =="
