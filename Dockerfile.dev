# Two targets:
#   app (default) - Rails only.
#   e2e           - app plus Node and Newman for running the Postman collection (bin/rails e2e:newman).
#                   Build with: docker build -f Dockerfile.dev --target e2e .
FROM ruby:4.0.9-slim-bookworm AS base

ARG APP_UID=1000
ARG APP_GID=1000

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential git libpq-dev libyaml-dev libvips pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid "$APP_GID" app \
    && useradd --uid "$APP_UID" --gid app --create-home app \
    && mkdir -p /app/backend \
    && chown -R app:app /app /usr/local/bundle

ENV HOME=/home/app
# /app/bin holds the repository-root wrappers, which work from any directory.
ENV PATH="/app/bin:${PATH}"
# Let bundler find the backend Gemfile regardless of the working directory.
ENV BUNDLE_GEMFILE=/app/backend/Gemfile

WORKDIR /app
USER app

COPY --chown=app:app backend/Gemfile backend/Gemfile.lock /app/backend/
RUN BUNDLE_FROZEN=true bundle install

EXPOSE 3000

CMD ["bin/dev"]

FROM base AS e2e
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm \
    && npm install -g newman@6 \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*
USER app

# Last stage is the default build target: no Node or Newman.
FROM base AS app
